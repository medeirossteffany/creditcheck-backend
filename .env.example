# API
PORT=3000
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=8h

# Infra (valores para rodar a API/worker localmente com postgres/rabbitmq do docker-compose)
DATABASE_URL=postgres://creditcheck:creditcheck@localhost:5432/creditcheck
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Administrador inicial (criado automaticamente na subida da API se não existir)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@creditcheck.local
ADMIN_PASSWORD=Admin@12345

# Consulta externa
EXTERNAL_API_URL=http://localhost:4000
EXTERNAL_API_TIMEOUT_MS=10000
CONSULTATION_TTL_HOURS=24
PENDING_TIMEOUT_MINUTES=10
WORKER_PREFETCH=5

# Mock da API externa (simula o bureau de crédito)
# - CPF inválido sempre retorna 422 (o worker marca a transação como FAILED, sem novas tentativas).
# - MOCK_FAILURE_RATE: probabilidade (0 a 1) de cada chamada retornar 503 "serviço indisponível".
#     0   = nunca falha
#     0.1 = 10% das chamadas falham (o worker tenta até 3 vezes, então quase sempre conclui)
#     1   = todas falham (útil para testar o fluxo FAILED no front)
MOCK_PORT=4000
MOCK_FAILURE_RATE=0.1
